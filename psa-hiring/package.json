{
  "name": "psa-workforce-hiring-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "config:check": "tsx --env-file-if-exists=.env.local scripts/check-env.ts",
    "local:setup": "tsx --env-file-if-exists=.env.local scripts/setup-local.ts",
    "infra:up": "docker compose up --detach --wait --wait-timeout 120",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "infra:logs": "docker compose logs --tail=200 --follow postgres mailpit",
    "infra:check": "tsx scripts/check-infra.ts",
    "db:bootstrap:local": "tsx --env-file-if-exists=.env.local scripts/db/bootstrap-local.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db/migrate.ts",
    "db:check": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db/check.ts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db/seed.ts",
    "db:verify-empty": "tsx --env-file-if-exists=.env.local scripts/db/verify-empty.ts",
    "db:catalog:apply": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db/authorization-catalog.ts apply",
    "db:catalog:check": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db/authorization-catalog.ts check",
    "test": "vitest run --project unit --project component",
    "test:watch": "vitest --project unit --project component",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --project component --coverage",
    "test:e2e": "tsx tests/e2e/support/run-with-database.ts",
    "test:e2e:critical": "tsx tests/e2e/support/run-with-database.ts tests/e2e --project=chromium --grep @critical",
    "test:a11y": "tsx tests/e2e/support/run-with-database.ts tests/accessibility --project=chromium",
    "test:data-guard": "tsx tests/guards/data-canary.ts",
    "test:critical-guard": "tsx tests/guards/critical-tests.ts",
    "test:foundation": "pnpm test:data-guard && pnpm test:critical-guard && pnpm test:coverage && pnpm test:integration && pnpm test:e2e:critical && pnpm test:a11y",
    "test:secrets": "tsx scripts/ci/secret-scan.ts",
    "test:deps": "tsx scripts/ci/dependency-audit.ts",
    "test:workflow-policy": "tsx scripts/ci/workflow-policy.ts",
    "test:artifact-guard": "tsx scripts/ci/artifact-guard.ts",
    "test:security": "pnpm test:secrets && pnpm test:deps && pnpm test:workflow-policy",
    "ci:local": "pnpm test:security && pnpm test:data-guard && pnpm test:critical-guard && pnpm format:check && pnpm lint && pnpm typecheck && pnpm auth:schema:check && pnpm db:check-drift && pnpm test:coverage && pnpm test:integration && pnpm build && pnpm test:e2e:critical && pnpm test:a11y",
    "auth:schema:check": "auth check schema --config src/modules/identity-access/infrastructure/auth.cli.ts",
    "db:check-drift": "tsx scripts/db/check-drift.ts",
    "auth:mailpit:check": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/auth/check-mailpit.ts",
    "auth:intent:local": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/auth/issue-candidate-invitation.ts",
    "auth:staff:invite:local": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/auth/create-local-staff-invitation.ts",
    "auth:staff:recovery:local": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/auth/staff-recovery-local.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "nodemailer": "10.0.15",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tw-animate-css": "^1.4.0",
    "uqr": "0.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@better-auth/utils": "0.4.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "12.2.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.3",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.9.1"
}
