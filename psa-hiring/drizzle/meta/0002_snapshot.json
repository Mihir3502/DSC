        "staff_invitation_status_check": {
          "name": "staff_invitation_status_check",
          "value": "\"auth\".\"staff_invitation\".\"status\" IN ('PENDING', 'ACCEPTED', 'REVOKED', 'EXPIRED', 'SUPERSEDED')"
        },
        "staff_invitation_purpose_check": {
          "name": "staff_invitation_purpose_check",
          "value": "\"auth\".\"staff_invitation\".\"purpose\" IN ('STAFF_ACTIVATION', 'STAFF_REENROLLMENT')"
        },
        "staff_invitation_issuer_reason_check": {
          "name": "staff_invitation_issuer_reason_check",
          "value": "\"auth\".\"staff_invitation\".\"issuer_reason_code\" IN ('LOCAL_BOOTSTRAP', 'TEST_HARNESS', 'RECOVERY_REENROLLMENT')"
        },
        "staff_invitation_email_normalized_check": {
          "name": "staff_invitation_email_normalized_check",
          "value": "\"auth\".\"staff_invitation\".\"email\" = lower(\"auth\".\"staff_invitation\".\"email\") AND \"auth\".\"staff_invitation\".\"email\" = btrim(\"auth\".\"staff_invitation\".\"email\") AND char_length(\"auth\".\"staff_invitation\".\"email\") BETWEEN 3 AND 254"
        },
        "staff_invitation_token_digest_check": {
          "name": "staff_invitation_token_digest_check",
          "value": "\"auth\".\"staff_invitation\".\"token_digest\" ~ '^[A-Za-z0-9_-]{43}$'"
        },
        "staff_invitation_sequence_check": {
          "name": "staff_invitation_sequence_check",
          "value": "\"auth\".\"staff_invitation\".\"sequence\" >= 1"
        },
        "staff_invitation_version_check": {
          "name": "staff_invitation_version_check",
          "value": "\"auth\".\"staff_invitation\".\"version\" >= 1"
        },
        "staff_invitation_expiry_check": {
          "name": "staff_invitation_expiry_check",
          "value": "\"auth\".\"staff_invitation\".\"expires_at\" > \"auth\".\"staff_invitation\".\"issued_at\""
        },
        "staff_invitation_accepted_check": {
          "name": "staff_invitation_accepted_check",
          "value": "(\"auth\".\"staff_invitation\".\"status\" = 'ACCEPTED') = (\"auth\".\"staff_invitation\".\"accepted_at\" IS NOT NULL) AND (\"auth\".\"staff_invitation\".\"status\" <> 'ACCEPTED' OR (\"auth\".\"staff_invitation\".\"account_id\" IS NOT NULL AND \"auth\".\"staff_invitation\".\"accepted_at\" <= \"auth\".\"staff_invitation\".\"expires_at\"))"
        },
        "staff_invitation_revoked_check": {
          "name": "staff_invitation_revoked_check",
          "value": "(\"auth\".\"staff_invitation\".\"status\" = 'REVOKED') = (\"auth\".\"staff_invitation\".\"revoked_at\" IS NOT NULL)"
        },
        "staff_invitation_superseded_check": {
          "name": "staff_invitation_superseded_check",
          "value": "(\"auth\".\"staff_invitation\".\"status\" = 'SUPERSEDED') = (\"auth\".\"staff_invitation\".\"superseded_at\" IS NOT NULL)"
        },
        "staff_invitation_expired_check": {
          "name": "staff_invitation_expired_check",
          "value": "(\"auth\".\"staff_invitation\".\"status\" = 'EXPIRED') = (\"auth\".\"staff_invitation\".\"expired_at\" IS NOT NULL)"
        },
        "staff_invitation_reenrollment_check": {
          "name": "staff_invitation_reenrollment_check",
