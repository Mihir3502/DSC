# Safe local-development values for the PSA Workforce Hiring System.
# This file contains NO production secrets and is committed on purpose.
#
# Create your own copy without overwriting an existing one:
#   cp -n .env.example .env.local
# .env.local is ignored by Git. Never commit real credentials.

# Environment name: local | test | staging | production
APP_ENV=local

# Database identities. LOCAL-ONLY passwords: never reuse them anywhere else.
#
# Runtime (web/worker): least-privileged role, data access only.
DATABASE_URL=postgresql://psa_app:psa_app_local_only_change_me@127.0.0.1:5432/psa_hiring
# Migration tools only (pnpm db:migrate): owns the app schema.
DATABASE_MIGRATION_URL=postgresql://psa_migrator:psa_migrator_local_only_change_me@127.0.0.1:5432/psa_hiring
# Local bootstrap only (pnpm db:bootstrap:local, db:verify-empty). This is
# the compose.yaml superuser; the application never reads this variable.
DATABASE_ADMIN_URL=postgresql://psa_local:psa_local_only_change_me@127.0.0.1:5432/psa_hiring

# Runtime pool limits (optional; these are the defaults).
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000

# Mailpit captures all mail locally (web UI: http://127.0.0.1:8025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@example.test

# Private local document directory (ignored by Git, never web accessible).
DOCUMENT_STORAGE_ROOT=./.local/documents

# Provider adapters: fake | production
PROVIDER_MODE=fake

# Host ports are 5432 (PostgreSQL), 1025 (SMTP), and 8025 (Mailpit UI).
# To change one, export POSTGRES_HOST_PORT, MAILPIT_SMTP_HOST_PORT, or
# MAILPIT_UI_HOST_PORT in your shell before pnpm infra:up / infra:check
# (Docker Compose does not read .env.local), then update the three
# DATABASE_*_URL values or SMTP_PORT above to match.

# Authentication (Better Auth, docs/adr/ADR-0002). LOCAL values only.
# Generate your own secret with:  openssl rand -hex 32
# The placeholder below is rejected by `pnpm config:check` on purpose.
BETTER_AUTH_SECRET=replace_with_output_of_openssl_rand_hex_32
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Session/verification/rate-limit policy (local defaults; final timeout and
# rate-limit policy is an open decision, see ADR-0002).
AUTH_SESSION_EXPIRES_IN_SECONDS=28800
AUTH_SESSION_UPDATE_AGE_SECONDS=3600
AUTH_VERIFICATION_EXPIRES_IN_SECONDS=3600
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
# Candidate registration and recovery (M1.2, docs/adr/ADR-0003).
# Local email goes to Mailpit only; staging/production startup refuses
# smtp-local and capture-file. capture-file is for APP_ENV=test only.
AUTH_EMAIL_TRANSPORT=smtp-local
AUTH_OTP_EXPIRES_IN_SECONDS=600
AUTH_RESET_EXPIRES_IN_SECONDS=1800
AUTH_PUBLIC_INTENT_EXPIRES_IN_SECONDS=3600
AUTH_INVITATION_EXPIRES_IN_SECONDS=604800
# Only a deterministic local denylist exists; production needs an approved
# privacy-preserving provider (open decision).
AUTH_COMPROMISED_PASSWORD_CHECK=local-denylist
# Staff invitation, MFA, recent authentication, and recovery (M1.3,
# docs/adr/ADR-0004). Local defaults; final production policy is an open
# decision. Values below 60 seconds for lockout/recent-auth are test-only.
AUTH_STAFF_INVITATION_EXPIRES_IN_SECONDS=259200
AUTH_STAFF_REENROLLMENT_EXPIRES_IN_SECONDS=14400
AUTH_STAFF_MFA_CHALLENGE_SECONDS=300
AUTH_STAFF_MFA_MAX_FAILURES=5
AUTH_STAFF_MFA_LOCKOUT_SECONDS=900
AUTH_STAFF_RECENT_AUTH_SECONDS=300
AUTH_STAFF_RECOVERY_EXPIRES_IN_SECONDS=259200
AUTH_STAFF_RECOVERY_APPROVAL_SECONDS=3600
