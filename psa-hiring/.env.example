# Safe local-development values for the PSA Workforce Hiring System.
# This file contains NO production secrets and is committed on purpose.
#
# Create your own copy without overwriting an existing one:
#   cp -n .env.example .env.local
# .env.local is ignored by Git. Never commit real credentials.

# Environment name: local | test | staging | production
APP_ENV=local

# Matches the LOCAL-ONLY defaults in compose.yaml. Do not reuse this
# password anywhere else.
DATABASE_URL=postgresql://psa_local:psa_local_only_change_me@127.0.0.1:5432/psa_hiring

# Mailpit captures all mail locally (web UI: http://127.0.0.1:8025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@example.test

# Private local document directory (ignored by Git, never web accessible).
DOCUMENT_STORAGE_ROOT=./.local/documents

# Provider adapters: fake | production
PROVIDER_MODE=fake

# Host ports are 5432 (PostgreSQL), 1025 (SMTP), and 8025 (Mailpit UI).
# To change one, export POSTGRES_HOST_PORT, MAILPIT_SMTP_HOST_PORT, or
# MAILPIT_UI_HOST_PORT in your shell before pnpm infra:up / infra:check
# (Docker Compose does not read .env.local), then update DATABASE_URL or
# SMTP_PORT above to match.
